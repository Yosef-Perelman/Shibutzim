# Copy to .env and adjust. .env is git-ignored and never read by agents; this file documents every variable.

# --- Docker Compose (local database container) ---
# Host port 5433: a Homebrew PostgreSQL commonly occupies 5432 on macOS.
POSTGRES_USER=shibutzim
POSTGRES_PASSWORD=shibutzim
POSTGRES_DB=shibutzim
POSTGRES_PORT=5433

# --- Server (server/app/config.py) ---
# SQLAlchemy URLs; the test database is created by docker/initdb/01-test-db.sql.
DATABASE_URL=postgresql+psycopg://shibutzim:shibutzim@localhost:5433/shibutzim
TEST_DATABASE_URL=postgresql+psycopg://shibutzim:shibutzim@localhost:5433/shibutzim_test

# JWT signing secret (HS256). Generate a real one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in hours; no refresh tokens in v1 (plan 001, open question 12).
JWT_EXPIRES_HOURS=8

# Origins allowed to call the API from a browser (the Vite dev server).
CORS_ORIGINS=["http://localhost:5173"]

# Folder with the built client (client/dist). The API serves it, with the index page for every address the
# client owns. Leave it alone in development: the folder does not exist and Vite serves the client.
# The Docker image sets it to /app/static; set it only to serve a client built elsewhere.
# STATIC_DIR=/app/static

# IANA time zone for work-day and week boundaries. Storage is always UTC.
TIMEZONE=Asia/Jerusalem

# Password shared by every seeded demo user (scripts/seed.py). Not used by the server itself.
SEED_PASSWORD=shibutzim-demo

# --- Scheduler (server/app/scheduler, plan 002) ---
# Hard constraints of the solver (product-definition §6.2). Defaults are the product's.
# Minimum rest in hours between two shifts of one employee.
SCHEDULER_MIN_REST_HOURS=8
# Most shifts one employee may get in a week.
SCHEDULER_MAX_SHIFTS_PER_WEEK=5
# Search budget (nodes, not seconds) so a solve is reproducible; the best result found is returned.
SCHEDULER_MAX_STEPS=200000

# --- Assistant (server/app/assistant, plan 004) ---
# Gemini API key from Google AI Studio. Leave empty to run without the assistant: every other screen works and
# POST /api/assistant/chat answers 503 assistant_unavailable. Evals and the handbook ingestion need it.
GEMINI_API_KEY=
# Chat model with function calling, and the embedding model (the column is vector(768), so keep 768 dimensions).
ASSISTANT_CHAT_MODEL=gemini-3.1-flash-lite
ASSISTANT_EMBEDDING_MODEL=gemini-embedding-001
# Most model round trips one chat message may take (a question needs two or three) and the provider timeout.
ASSISTANT_MAX_STEPS=6
ASSISTANT_TIMEOUT_SECONDS=30
