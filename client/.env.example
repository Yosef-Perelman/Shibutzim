# Copy to .env.local only if you need to change a default. .env files are never read by agents.

# Base URL of the API. Leave empty in development: the Vite dev server proxies /api to
# http://localhost:8000, so the browser stays same-origin. Set it to call another host.
VITE_API_URL=

# Comma-separated emails of the seeded accounts the demo-user switch offers on the login screen and in
# the user menu. The password is typed once and kept in memory, never stored. It is read when the client
# is built: here by the dev server, and for the public demo by the Docker build (the DEMO_USERS GitHub
# variable, docs/deployment.md). Leave empty to hide the switch.
VITE_DEMO_USERS=dana@shibutzim.example,noa@shibutzim.example,omer@shibutzim.example,tamar@shibutzim.example,yonatan@shibutzim.example,lior@shibutzim.example
